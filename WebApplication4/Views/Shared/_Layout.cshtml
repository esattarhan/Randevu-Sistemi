    <!-- SİTEDEKİ HER SAYFANIN EN ALTINDA GÖRÜNECEK ALAN -->
    <footer class="footer text-center">
        <div class="container">
            <span>&copy; 2026 - Tüm Hakları Saklıdır</span>

            <!-- MAİL BUTONUN BURADA -->
            <email mail="ayluctarhanhairartist@gmail.com" display="Sorun ve Geri Bildirim İçin Tıklayınız"></email>
        </div>
    </footer class="footer text-center">
    <div class="container">
        <p class="mb-0 text-dark fw-bold">Gelişim aşamasında bir proje olduğundan zaman zaman meydana gelen hatalara gösterdiğiniz anlayıştan dolayı teşekkür ederiz.  </p>
    </div>
