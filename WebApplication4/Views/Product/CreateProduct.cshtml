@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model WebApplication4.Models.Product

<h2>Yeni Ürün</h2>

<form asp-action="CreateProduct" asp-controller="Product" method="post">
    <div class="form-group">
        <label>Ürün Adı</label>
        <input class="form-control" type="text" asp-for="ProductName" placeholder="Ürün adı giriniz"/>
    </div>
    <div class="form-group">
        <label>Miktar</label>
        <input class="form-control" type="number" asp-for="Quantity" placeholder="Kaç Adet istediğiniz giriniz" />
    </div>
    <div class="form-group">
        <label>Kategori</label>
        <input class="form-control" type="text" asp-for="Category" placeholder="Örn: Giyim, Elektronik" />
    </div>
    <button class="btn btn-primary" type="submit">Kaydet</button>
</form>

<a href="/Product/GetProducts" class="btn btn-secondary" style="margin-top:10px">&lt;&lt; Geri Gel</a>
